{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "agri_vision/**",
        "climate/**",
        "graphcast/**",
        "remote_sensing/**",
        "timesfm/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
